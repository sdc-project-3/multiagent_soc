# =============================================================================
# SENTINELX — Environment Configuration Template
# =============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS and OAuth redirect callbacks)
CLIENT_URL=http://localhost:5173

# MongoDB Connection URI (Local MongoDB server)
MONGODB_URI=mongodb://localhost:27017/sentinelx

# Session & JWT Secret Key (Use a strong random 256-bit string in production)
JWT_SECRET=sentinelx_cyber_jwt_secret_key_super_secure_2026_x89f
SESSION_SECRET=sentinelx_session_secret_key_defcon_4_neural_grid
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (Optional - configure from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth App Credentials (Optional - configure from GitHub Developer Settings)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
